# Create a bot in the Discord Developer Portal and paste its token here.
DISCORD_TOKEN=replace-with-your-bot-token

# Required when a Palworld server uses "statusProtocol": "rest".
# This must match AdminPassword in PalWorldSettings.ini.
PALWORLD_ADMIN_PASSWORD=replace-with-your-palworld-admin-password

# Optional: overrides discord.channelId in config/servers.json.
# DISCORD_CHANNEL_ID=123456789012345678

# Optional: defaults to config/servers.json.
# CONFIG_PATH=config/servers.json
